# Copy to .env (repo root) or backend/.env and fill in locally. .env is git-ignored; never commit it.
# Real environment variables override both files. Clavion needs no API keys: everything runs locally.

# DATABASE_URL=sqlite:///./clavion.db
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO

# Local-only default. Enable before exposing the API beyond a trusted loopback interface.
AUTH_ENABLED=false
# Generate offline from backend/: python -m app.password
# Set the output in the host's secret environment as AUTH_PASSWORD_HASH (never in VITE_*).
# AUTH_PASSWORD_HASH=
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
AUTH_SESSION_SECONDS=28800
