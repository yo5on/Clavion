# Copy to .env (repo root) or backend/.env and fill in locally. .env is git-ignored; never commit it.
# Real environment variables override both files.

# Developer API key from your BharatCode account. Server-side only.
BHARATCODE_API_KEY=
# Official base URL from https://bharatcode.ai/build (note the /model segment).
BHARATCODE_BASE_URL=https://bharatcode.ai/api/model/v1
# qwen-3.8-27b: Lite, Pro, verified students. deepseek-v4.1-flash: Pro only.
BHARATCODE_MODEL=qwen-3.8-27b

# Optional tuning (seconds / count)
# BHARATCODE_CONNECT_TIMEOUT=10
# BHARATCODE_REQUEST_TIMEOUT=180
# BHARATCODE_MAX_RETRIES=2

# DATABASE_URL=sqlite:///./clavion.db
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
