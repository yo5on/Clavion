# Copy to backend/.env and fill in. Never commit .env.

# BharatCode API key (https://bharatcode.ai/build). Server-side only.
BHARATCODE_API_KEY=
BHARATCODE_BASE_URL=https://bharatcode.ai/api/model/v1
# qwen-3.8-27b: Students/Lite/Pro. deepseek-v4.1-flash: Pro only.
BHARATCODE_MODEL=qwen-3.8-27b
LLM_TIMEOUT_SECONDS=120

# Default: backend/clavion.db
# DATABASE_URL=sqlite:///./clavion.db
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
